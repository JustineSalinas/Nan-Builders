# Nan Builders — environment variables
# Copy this file to `.env.local` and fill in the values.

# ---------------------------------------------------------------------------
# Canonical site URL (no trailing slash)
# ---------------------------------------------------------------------------
# Drives sitemap.xml, robots.txt, JSON-LD, canonical tags and OG image URLs.
# Leave blank locally (falls back to http://localhost:3000). On Vercel it falls
# back to the project's production URL automatically, but set it explicitly once
# the real domain is pointed at the site, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://nanbuilders.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Email delivery (contact + careers forms) — plain SMTP
# ---------------------------------------------------------------------------
# Any SMTP host works; switching providers is an env change, not a code change.
# Leave these blank and the site still works: submissions show a friendly
# fallback pointing people at the phone number, and nothing is emailed.
#
# Gmail (no domain required — good until the real domain is live):
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Use the 16-character password below (spaces are fine).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#
# Brevo — 300/day free, keeps mail off a personal account:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#
# Resend, once the domain is verified there:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=<your re_... API key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to SMTP_USER, which is what most hosts require — they
# reject a From address the authenticated account doesn't own. Once you have a
# verified domain you can set e.g.:
#   CONTACT_FROM="Nan Builders <no-reply@nanbuilders.com>"
CONTACT_FROM=

# Optional. Where form submissions land. Defaults to the address in lib/site.ts.
CONTACT_TO=
