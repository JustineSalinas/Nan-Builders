# Nan Builders — environment variables
# Copy this file to `.env.local` and fill in the values.

# ---------------------------------------------------------------------------
# Canonical site URL (no trailing slash)
# ---------------------------------------------------------------------------
# Drives sitemap.xml, robots.txt, JSON-LD, canonical tags and OG image URLs.
# Leave blank locally (falls back to http://localhost:3000). On Vercel it falls
# back to the project's production URL automatically, but set it explicitly once
# the real domain is pointed at the site, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://nanbuilders.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Email delivery (contact + careers forms)
# ---------------------------------------------------------------------------
# Resend API key — powers the contact & careers forms.
# Get one at https://resend.com (free tier available).
# Without it, the site still works: submissions show a friendly fallback
# message pointing users to the phone/email, and nothing is emailed.
RESEND_API_KEY=

# Verified "from" sender for outgoing mail.
# Use Resend's shared sandbox sender for testing:
#   CONTACT_FROM="Nan Builders <onboarding@resend.dev>"
# For production, verify your own domain in Resend and use e.g.:
#   CONTACT_FROM="Nan Builders <no-reply@nanbuilders.com>"
CONTACT_FROM=
